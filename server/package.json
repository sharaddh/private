{
  "name": "kmj-erp-server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .", 
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "migrate": "ts-node src/migrations/migrate-legacy.ts",
    "migrate:inventory": "ts-node src/migrations/migrate-inventory.ts",
    "migrate:halve-lens": "ts-node src/scripts/halve-lens-stock.ts",
    "migrate:double-lens": "ts-node src/scripts/double-lens-stock.ts",
    "etl": "ts-node src/scripts/etl-mongo-to-postgres.ts",
    "recalculate": "ts-node src/scripts/recalculate-customers.ts",
    "postinstall": "node -e \"console.log('no postinstall needed')\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^5.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.2.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
