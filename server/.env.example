# MongoDB
MONGO_URI=mongodb://localhost:27017/kmj-erp

# PostgreSQL (Prisma). Required for the Postgres migration target.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kmj-erp?schema=public

# Auth (access token now lasts 7 days to keep sessions alive)
JWT_SECRET=your-secret-key-here
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=7d

# Rate limiting (per window; defaults: 1000/min global, 30/min for auth)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

# Redis (optional). When set, rate-limit counters are shared across instances.
# Leave empty to fall back to the in-memory store.
REDIS_URL=

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# Clustering (optional; enables multiple worker processes)
ENABLE_CLUSTER=false
CLUSTER_WORKERS=0

# Warehouse database
WAREHOUSE_DB_NAME=kmj_warehouse

# Timezone
TZ=Asia/Kolkata
