# PostgreSQL — use your Neon pooled connection string for production
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# PostgreSQL — unpooled endpoint for migrations and long-running jobs
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

# Redis (optional; app falls back to in-memory when empty)
# Upstash: rediss://default:password@host:port
REDIS_URL=

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# Clustering
ENABLE_CLUSTER=false
CLUSTER_WORKERS=0

# Warehouse
WAREHOUSE_DB_NAME=kmj_warehouse

TZ=Asia/Kolkata

# WhatsApp Cloud API (official Meta integration only)
# Keep mock for local/test. Switch to meta only after the documented handoff.
WHATSAPP_PROVIDER=mock
META_GRAPH_API_VERSION=v23.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PUBLIC_URL=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_SEND_ENABLED=false
WHATSAPP_CAMPAIGN_SEND_ENABLED=false
WHATSAPP_MAX_WORKER_CONCURRENCY=1
WHATSAPP_QUEUE_NAME=whatsapp-notifications
WHATSAPP_WORKER_POLL_MS=5000
WHATSAPP_MAX_ATTEMPTS=5
WHATSAPP_WORKER_INLINE=false
# Optional send window to keep idle compute cheap on Neon (hours are 0-23 local time)
WHATSAPP_WORKER_WINDOW_ENABLED=false
WHATSAPP_WORKER_WINDOW_START=9
WHATSAPP_WORKER_WINDOW_END=21
WHATSAPP_WORKER_TIMEZONE=Asia/Kolkata