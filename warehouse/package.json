{
  "name": "warehouse-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('static.json','dist/static.json')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
